# Python
__pycache__/
*.pyc
.venv/

# Local model service config (credentials, machine-specific settings)
config.local.json

# Private material: never commit your own corpus, resume, JDs or generated runs
/experiences/*
!/experiences/.gitkeep
/resume/*
!/resume/.gitkeep
/jobs/*
!/jobs/.gitkeep
/outputs/*
!/outputs/.gitkeep
/_sources/
/_review/
site/
*.log
.env
.env.*
!.env.example
private_patterns*.json

# Local runtime and generated artifacts
/state/*
!/state/.gitignore
/output/
config.docker.json
/frontend/node_modules/
/frontend/dist/
/frontend/*.tsbuildinfo
/frontend/vite.config.js
/frontend/vite.config.d.ts
.seek_cache/
seek_output/
_seek_*.txt
.seek_*.json
