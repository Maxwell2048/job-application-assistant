# Backend settings (copy to .env; .env is git-ignored). Every key is optional.
# RAG_DATABASE_URL=postgresql+psycopg://rag:password@127.0.0.1:5432/job_rag
# RAG_AUTOPILOT_ENABLED=true
# RAG_AUTOPILOT_INTERVAL_HOURS=6
# Search mode before the first switch on the page: focused (graduate/junior/entry level/trainee) or broad (all Perth ICT)
# RAG_SEARCH_MODE=focused
# Per round; details are read only for jobs not yet in the ledger, the rest wait for the next round.
# RAG_SEEK_MAX_PAGES=2
# RAG_SEEK_MAX_DETAILS=40
# RAG_SEEK_BROAD_MAX_PAGES=15
# RAG_SEEK_BROAD_MAX_DETAILS=40
# RAG_SEEK_REQUEST_DELAY_SECONDS=8
# RAG_SEEK_EXCLUDED_SUBCLASSES=Management,Architects,Team Leaders,CTO/CIO
# RAG_RETRY_FAILED_GENERATION=true
# Before the first switch on the page: queue screened jobs for generation (true) or only list them as "ready" (false)
# RAG_AUTO_GENERATE=false
# Existing private runtime directory (collector source is bundled):
# RAG_COLLECTOR_DIR=C:\path\to\collector-runtime
# Your own script that starts the local model server (llama-server):
# RAG_MODEL_LAUNCHER=C:\path\to\start-llm.bat
# Screening criteria:
# RAG_EXCLUDE_TITLE_PATTERN=\b(senior|sr\.?|lead|principal|manager|head|director|architect|mid[- ]?level|intermediate)\b
# RAG_LOCATION_KEYWORD=perth
# RAG_ALLOW_REMOTE=true
# RAG_REQUIRE_FULL_TIME=true
# RAG_ACCEPT_CONTRACT=true
# Fit gate (level, mandatory years, kind of work, stack, degree, practical constraints):
# RAG_FIT_SCREEN_ENABLED=true
# RAG_MAX_REQUIRED_YEARS=2
# Levels screened out when the JD also calls the hire senior/experienced/mid-level in words:
# RAG_FIT_SKIP_LEVELS=["mid","senior"]
# run = no remark, flag = run with a remark, skip = screened out (only if the title has no technical word)
# RAG_ROLE_FAMILY_ACTIONS={"software_dev":"run","data_ai":"run","it_support":"flag","infrastructure":"flag","security":"flag","business_analysis":"flag","non_technical":"skip"}
# Constraints that screen a job out when rule and model both find them (default: none, only flagged):
# RAG_FIT_SKIP_CONSTRAINTS=["shift_work"]
# RAG_PROFILE_PATH=experiences\profile.md

# Docker Compose only (compose.yaml reads these from .env; the password is required there):
# POSTGRES_PASSWORD=choose-a-password
# POSTGRES_USER=rag
# POSTGRES_DB=job_rag
# HF_CACHE_DIR=C:/Users/you/.cache/huggingface
